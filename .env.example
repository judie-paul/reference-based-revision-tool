# Copy this file to ".env" in the folder you run the program from, then fill
# in your keys. Real environment variables take precedence over this file.

# --- LLM (required) ---------------------------------------------------------
# Option A: Anthropic Claude (default)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5          # default; e.g. claude-sonnet-5-5 or claude-haiku-5-5 are cheaper
# LLM_EFFORT=medium                  # low | medium | high | xhigh | max

# Option B: any OpenAI-compatible API (OpenAI, Google Gemini, Groq, OpenRouter, Ollama, ...)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=                         # required for this provider
# LLM_CONTEXT_WINDOW=128000          # set to your model's context window

# LLM_MAX_OUTPUT_TOKENS=16000        # tokens reserved for each reply

# --- External search (optional) ---------------------------------------------
# Used only when your documents cannot answer a question.
# Without a key, such questions are reported as not answered.
TAVILY_API_KEY=
# SEARCH_MAX_RESULTS=5

# --- Upload limits ----------------------------------------------------------
# MAX_REFERENCE_FILE_MB=10
# MAX_PAPER_FILE_MB=10
# MAX_REFERENCE_DOCS=5

# --- Server -----------------------------------------------------------------
# ADDR=127.0.0.1:8080
# DB_PATH=revision.db
